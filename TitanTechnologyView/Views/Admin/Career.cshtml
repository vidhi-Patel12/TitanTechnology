<div class="hero-area-form style-one d-flex align-items-center">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcumb-content">
                    @* <h4>Career</h4> *@
                    <ul>
                        <li><a asp-action="Index" asp-controller="Home">Home</a></li>
                        <li>></li>
                        <li>Career</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>


<div id="careerListSection" class="container my-5">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Career</h2>
        @* <a asp-action="AddEdit" asp-controller="career" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Add career
        </a> *@
        <button type="button" class="btn btn-primary mb-3 float-end"
                style="background-color: #1b3f6f;"
                onclick="showSection('addCareerSection')">
            <i class="fas fa-plus-circle me-2"></i> Add New
        </button>

    </div>
    <div class="table-responsive">
        <table id="careerTable" class="table table-striped table-hover align-middle" style="width:100%">
            <thead class="table-dark">
                @* <table id="careerTable" class="table table-striped table-bordered">
        <thead> *@
                <tr>
                    <th>Employement Type</th>
                    <th>Location</th>
                    <th>Job Title</th>
                    <th>Job Description</th>
                    <th style="width:120px;">Action</th>
                </tr>
            </thead>
            <tbody id="careerTableBody">
                <!-- Rows load dynamically -->
            </tbody>
        </table>
    </div>
</div>


<div id="addCareerSection" class="contact-area style-three inner" style="display:none;">
    <div class="container">
        <div class="row add-white-bg align-items-center">
            <div class="col-lg-12 col-md-12">
                <div class="single-contact-box">
                    <div class="contact-contetn">
                        <h4>Add Career</h4>
                    </div>
                    <form id="careerForm" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="dropdown">
                                    <!-- Input field toggles dropdown -->
                                    <input type="text" id="careerInput"
                                           class="form-control dropdown-toggle"
                                           placeholder="Select name..."
                                           data-bs-toggle="dropdown" aria-expanded="false" required>
                                    <span class="text-danger field-validation"></span>

    
                                    <!-- Dropdown list -->
                                    <ul id="dynamicCareer" class="dropdown-menu w-100">
                                        <li><span class="dropdown-item-text text-muted">Loading...</span></li>
                                    </ul>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div>
                                    <input type="text" id="location" name="Location" class="form-control" placeholder="Enter location" required />
                                    <span class="text-danger field-validation"></span>

                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-6 mt-3">
                                <div>
                                    <input type="text" id="jobTitle" name="JobTitle" class="form-control" placeholder="Enter job title" required />
                                    <span class="text-danger field-validation"></span>

                                </div>
                            </div>
                            <div class="col-lg-6 mt-3">
                                <div>
                                    <input type="text" id="jobDescription" name="JobDescription" class="form-control" placeholder="Enter job description" required />
                                    <span class="text-danger field-validation"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-lg-6 mt-3">
                                <button type="button" id="btnSave" class="btn col-lg-3 btn-primary mt-2">Save</button>
                                <button type="button" id="btnCancel" class="btn col-lg-3 btn-secondary mt-2">Cancel</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>


<div id="updateCareerSection" class="contact-area style-three inner" style="display:none;">
    <div class="container">
        <div class="row add-white-bg align-items-center">
            <div class="col-lg-12 col-md-12">
                <div class="single-contact-box">
                    <div class="contact-contetn">
                        <h4>Update Career</h4>
                    </div>

                    <!-- Hidden field to hold the careerId -->
                    <input type="hidden" id="updateCareerId" />

                    <div class="row">
                        <div class="col-lg-6">
                            <div class="dropdown">
                                <!-- Input field toggles dropdown -->
                                <input type="text" id="updateCareerInput"
                                       class="form-control dropdown-toggle"
                                       placeholder="Select employement type..."
                                       data-bs-toggle="dropdown" aria-expanded="false" required>
                                <!-- Dropdown list -->
                                <ul id="updateDynamicCareer" class="dropdown-menu w-100">
                                    <li><span class="dropdown-item-text text-muted">Loading...</span></li>
                                </ul>
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div>
                                <input type="text" id="updateLocation" name="Location"
                                       class="form-control" placeholder="Enter location" required />
                            </div>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-lg-6">
                            <div>
                                <input type="text" id="updateJobTitle" name="JobTitle"
                                       class="form-control" placeholder="Enter job title" required />
                            </div>
                        </div>
                        <div class="col-lg-6">
                            <div>
                                <input type="text" id="updateJobDescription" name="JobDescription"
                                       class="form-control" placeholder="Enter job description" required />
                            </div>
                        </div>
                    </div>

                    <div class="row mt-3">
                        <div class="col-lg-6">
                            <button type="button" id="btnUpdate" class="btn col-lg-3 btn-primary">Update</button>
                            <button type="button" id="btnUpdateCancel" class="btn col-lg-3 btn-secondary">Cancel</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




<!-- View Career Modal -->
<div class="modal fade" id="viewCareerModal" tabindex="-1" aria-labelledby="viewCareerLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="viewCareerLabel">Career Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <!-- Left Side: Name & Description -->
                    <div class="col-md-12">
                        <h6 class="fw-bold">Employement Type</h6>
                        <p id="viewCareerEmployementType"></p>

                        <h6 class="fw-bold">Location</h6>
                        <p id="viewCareerLocation"></p>

                        <h6 class="fw-bold">Job Title</h6>
                        <p id="viewCareerJobTitle"></p>

                        <h6 class="fw-bold">Job Description</h6>
                        <p id="viewCareerJobDescription"></p>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>


<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this project?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button id="confirmDeleteBtn" type="button" class="btn btn-danger">Delete</button>
            </div>
        </div>
    </div>
</div>


<!--  Script order matters -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<!-- DataTables core (must come BEFORE bootstrap integration) -->
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<!-- DataTables bootstrap 5 integration -->
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script src="~/js/career.js"></script>
