<div class="hero-area-form style-one d-flex align-items-center">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcumb-content">
                    <h4>Solutions</h4>
                    <ul>
                        <li><a asp-action="Index" asp-controller="Home">Home</a></li>
                        <li>></li>
                        <li>Solution</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>


<div id="solutionListSection" class="container my-5">
    <h2 class="mb-4">Solution List</h2>
    <div class="row">
        <div class="col-md-6">
        </div>
        <div class="col-md-6 text-end">
            <button type="button" class="btn btn-primary mb-3 float-end" style="background-color: #1b3f6f;"
                    onclick="showSection('addSolutionSection')">
                <i class="fas fa-plus-circle me-2"></i> Add Solution
            </button>
        </div>

        <table id="solutionTable" class="table table-striped table-bordered">
            <thead>
                <tr>
                    <th>Solution Name</th>
                    <th>Description</th>
                    <th style="width: 120px;">Action</th>
                </tr>
            </thead>
            <tbody id="solutionTableBody">
                <!-- Data loads dynamically -->
            </tbody>
        </table>
    </div>
</div>


<!-- Add Solution Section -->
<div id="addSolutionSection" class="container solution-container align-items-center mt-5 mb-5" style="display:none;">
    <div class="row justify-content-center">
        <div class="col-md-6 solution-box border rounded p-4 shadow-sm">
            <h2 class="mb-4">Add Solution</h2>
            <form id="solutionForm" enctype="multipart/form-data">

                <div class="mb-3">
                    <input type="text" id="solutionName" name="SolutionName" class="form-control" placeholder="Solution Name*"
                           required>
                </div>

                <div class="mb-3">
                    <textarea id="description" name="Description" class="form-control" placeholder="Description*"
                              required></textarea>
                </div>

                <div class="mb-3 position-relative">
                    <input type="file" id="imageFile" name="imageFile" class="form-control" accept="image/png" required>
                    <span id="filePlaceholder" class="position-absolute text-muted"
                          style="top: 50%; left: 250px; transform: translateY(-50%); pointer-events: none; font-size: 0.9em;">
                        Must be 100×100 px or smaller and PNG
                    </span>
                </div>

                <div id="fileMessage" class="position-absolute text-danger"
                     style="top: 205%;left: 365px;transform: translateY(-50%); pointer-events: none; font-size: 0.9em;display: none;">
                    Image must be 100×100 px or smaller and png.
                </div>

                <div class="mb-3 text-center">
                    <img id="previewImage" src="" alt="Preview" class="img-fluid border rounded"
                         style="max-width:200px; display:none;">
                </div>

                <!-- Validation message will appear here -->
                <div id="imageMessage" class="text-danger mb-3" style="min-height:1.2em;"></div>


                <input type="hidden" name="IsActive" value="true">
                <input type="hidden" id="createdDate" name="CreatedDate" value="">

                <button type="submit" class="btn btn-dark rounded-pill px-4">Save Solution</button>
                <button type="button" class="btn btn-secondary rounded-pill px-4"
                        onclick="showSection('solutionListSection')">
                    Cancel
                </button>
            </form>
            <div id="result" class="mt-3"></div>
        </div>
    </div>
</div>


<!-- Update Solution Section -->

<div id="updateSolutionSection" class="container solution-container mt-5 mb-5" style="display:none;">
    <div class="row justify-content-center">
        <div class="col-md-6 solution-box border rounded p-4 shadow-sm">
            <h2 class="mb-4">Update Solution</h2>
            <form id="updateForm" enctype="multipart/form-data">
                <input type="hidden" id="solutionId" name="SolutionId">

                <div class="mb-3">
                    <input type="text" id="updateSolutionName" name="SolutionName" class="form-control"
                           placeholder="Solution Name*" required>
                </div>

                <div class="mb-3">
                    <textarea id="updateDescription" name="Description" class="form-control" placeholder="Description*"
                              required></textarea>
                </div>

                <div class="mb-3 position-relative">
                    <label class="form-label">Image</label>
                    <input type="file" id="updateImageFile" name="imageFile" class="form-control" accept="image/png">
                    <span id="updateFilePlaceholder" class="position-absolute text-muted"
                          style="top: 70%;left: 250px; transform: translateY(-50%); pointer-events: none; font-size: 0.9em;">
                        Must be 100×100 px or smaller and PNG.
                    </span>
                </div>

                <div id="updateFileMessage" class="text-danger mb-2" style="display:none; font-size:0.9em;">
                    Image must be 100×100 px or smaller and PNG.
                </div>

                <div class="mb-3 text-center">
                    <img id="updatePreviewImage" src="" alt="Preview" class="img-fluid border rounded"
                         style="max-width:100px; display:none;">
                    <p id="currentImageName" style="margin-left:-425px;" class="text-muted mt-2"></p>
                </div>

                <input type="hidden" id="updateImage" name="Image" value="">
                <input type="hidden" name="IsActive" value="true">
                <input type="hidden" id="updatedDate" name="UpdatedDate">

                <button type="submit" class="btn btn-dark rounded-pill px-4">Update Solution</button>
                <button type="button" class="btn btn-secondary rounded-pill px-4"
                        onclick="showSection('solutionListSection')">
                    Cancel
                </button>
            </form>
            <div id="updateResult" class="mt-3"></div>
        </div>
    </div>
</div>

<!-- View Solution Modal -->
<div class="modal fade" id="viewSolutionModal" tabindex="-1" aria-labelledby="viewSolutionLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="viewSolutionLabel">Solution Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="row">
                    <!-- Left Side: Name & Description -->
                    <div class="col-md-6">
                        <h6 class="fw-bold">Name</h6>
                        <p id="viewSolutionName"></p>

                        <h6 class="fw-bold">Description</h6>
                        <p id="viewSolutionDescription"></p>
                    </div>

                    <!-- Right Side: Image -->
                    <div class="col-md-6 text-center">
                        <img id="viewSolutionImage" src="" alt="Solution Image" class="img-fluid rounded shadow-sm"
                             style="max-height:250px;max-width:250px;">
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>

        </div>
    </div>
</div>


<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this solution?
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button id="confirmDeleteBtn" type="button" class="btn btn-danger">Delete</button>
            </div>
        </div>
    </div>
</div>


<!--  Script order matters -->
<script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
<!-- DataTables core (must come BEFORE bootstrap integration) -->
<script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

<!-- DataTables bootstrap 5 integration -->
<script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

<script src="~/js/solution.js"></script>
