@using TitanTechnologyView.Models
@model TitanTechnologyView.Models.ProjectMaster
@{
    ViewData["Title"] = Model?.ProjectCode == null ? "Add Project" : "Edit Project";
}

<div class="hero-area-form style-one d-flex align-items-center">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcumb-content">
                    @* <h4>Project Masters</h4> *@
                    <ul>
                        <li><a asp-action="Index" asp-controller="Home">Home</a></li>
                        <li>></li>
                        <li>@ViewData["Title"]</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="contact-area style-three inner">
    <div class="container">
        <div class="row add-white-bg align-items-center">
            <div class="col-lg-12 col-md-12">
                <div class="single-contact-box">
                    <div class="contact-contetn">
                        <h4>@ViewData["Title"]</h4>
                    </div>

                    <form id="projectMasterForm" asp-controller="ProjectMaster" asp-action="Save" method="post">

                        <!-- Hidden input for redirect flag -->
                        <input type="hidden" id="RedirectToEmployee" name="RedirectToEmployee" value="false" />
                        <div class="row">

                            <!-- ProjectCode -->
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    @if (Model?.ProjectCode == null) // Add mode
                                    {
                                        <input asp-for="ProjectCode" type="text" placeholder="Project Code" id="ProjectCodeInput" required />
                                    }
                                    else // Edit mode
                                    {
                                        <input asp-for="ProjectCode" type="text" readonly />
                                        <input type="hidden" asp-for="ProjectCode" />
                                    }
                                    <span asp-validation-for="ProjectCode" class="text-danger field-validation"></span>
                                </div>
                                <div class="single-input-box">
                                    <input asp-for="ProjectName" type="text" placeholder="Project Name" required />
                                    <span asp-validation-for="ProjectName" class="text-danger field-validation"></span>
                                </div>
                                     <span asp-validation-for="ProjectCode" class="text-danger"></span>
                                     <span id="projectCodeError" class="text-danger"></span>
                                 </div>
                            </div>

                            <!-- Description -->
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <textarea style="height: 120px;" asp-for="Description" placeholder="Project Description" required></textarea>
                                    <span asp-validation-for="Description" class="text-danger field-validation"></span>
                                </div>

                            </div>


                            <!-- StartDate -->
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <label asp-for="StartDate" class="form-label" style="color:black">Project Start Date</label>
                                    <input asp-for="StartDate" type="date" id="StartDate" required />
                                    <span asp-validation-for="StartDate" class="text-danger field-validation"></span>
                                </div>
                            </div>

                            <!-- EndDate -->
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <label asp-for="EndDate" class="form-label" style="color:black">Project End Date</label>
                                    <input asp-for="EndDate" type="date" id="EndDate" required />
                                    <span asp-validation-for="EndDate" class="text-danger field-validation"></span>
                                    <span id="dateError" class="text-danger"></span>
                                </div>
                            </div>

                            <!-- Customer -->
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <select asp-for="CustomerId" required
                                    <select asp-for="CustomerId" class="form-select"
                                            asp-items="@(ViewBag.Customers != null
                                                                                    ? new SelectList(ViewBag.Customers, "CustomerId", "CustomerName", Model?.CustomerId)
                                                                                    : new List<SelectListItem>())">
                                        <option value=""> Select Customer </option>
                                    </select>
                                    <span asp-validation-for="CustomerId" class="text-danger field-validation"></span>
                                </div>
                            </div>

                            <!-- CustomerRate -->
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="CustomerRate" type="number" step="0.01" placeholder="Customer Rate" required/>
                                    <span asp-validation-for="CustomerRate" class="text-danger field-validation"></span>
                                </div>
                            </div>

                            <!-- RateUnit -->
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="RateUnit" type="text" placeholder="Rate Unit" required />
                                    <span asp-validation-for="RateUnit" class="text-danger field-validation" ></span>
                                </div>
                            </div>

                            <!-- HsCode -->
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="HsCode" type="text" placeholder="HS Code" required />
                                    <span asp-validation-for="HsCode" class="text-danger field-validation" ></span>
                                </div>
                            </div>

                            <!-- Notes -->
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="Notes" type="text" placeholder="Notes" required />
                                    <span asp-validation-for="Notes" class="text-danger field-validation"></span>
                                </div>
                            </div>

                            <!-- ApprovalLevel -->
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <select asp-for="ApprovalLevel"
                                            asp-items="@(new SelectList((List<DropdownMaster>)ViewBag.TimesheetApprovalLevel, "Value", "Value", Model.ApprovalLevel))"
                                            class="form-select" required>
                                        <option value="">Select Approval Level</option>
                                    </select>
                                <span asp-validation-for="ApprovalLevel" class="text-danger field-validation"></span>
                                </div>
                            </div>

                            <!-- Status -->
                             <input type="hidden" asp-for="Status" value="Active" />

                           @*  <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="Status" type="text" placeholder="Status" />
                                    <span asp-validation-for="Status" class="text-danger"></span>
                                </div>
                            </div> *@

                            <!-- Buttons -->
                            <div class="d-flex gap-3 mt-4">
                                <button type="submit" class="btn btn-primary px-4" id="btnSave">Save</button>
                                <a asp-action="Index" class="btn btn-outline-secondary px-4">Back</a>
                            </div>

                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Save Confirmation Modal -->
<div class="modal fade" id="saveModal" tabindex="-1" aria-labelledby="saveModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="saveModalLabel">Confirmation</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Do you want to add employees for this project?
            </div>
            <div class="modal-footer">
                <button type="button" id="btnSaveOnly" class="btn btn-success">Save</button>
                <button type="button" id="btnSaveAndAdd" class="btn btn-primary">Save & Add employee</button>
            </div>
        </div>
    </div>
</div>


<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("projectMasterForm");
        const requiredFields = form.querySelectorAll("input[required], select[required], textarea[required]");

        // Validate on blur (inputs) and change (selects)
        requiredFields.forEach(field => {
            field.addEventListener("blur", () => validateField(field));
            field.addEventListener("change", () => validateField(field));
        });

        // Validate all on submit
        form.addEventListener("submit", function (e) {
            let valid = true;
            requiredFields.forEach(field => {
                if (!validateField(field)) valid = false;
            });

            if (!valid) {
                e.preventDefault();
                // alert("Please fill all required fields correctly.");
        const btnSave = document.getElementById("btnSave");
        const form = document.getElementById("projectMasterForm");
        const projectCodeInput = document.getElementById("ProjectCodeInput");
        const projectCodeError = document.getElementById("projectCodeError");
        const redirectInput = document.getElementById("RedirectToEmployee");

        // Save confirmation popup with duplicate check
        btnSave?.addEventListener("click", async function (e) {
            e.preventDefault();
            
           const code = projectCodeInput?.value.trim();
            if (!code) 
            {
                return;
            }

            try {
                // Call API to check duplicate ProjectCode
                const res = await fetch(`/ProjectMaster/CheckProjectCode?projectCode=${code}`);
                const data = await res.json();

                if (data.exists) {
                    // Show message and stop save
                    projectCodeError.textContent = "Project Code already exists!";
                    projectCodeInput.focus();
                    return; // stop further action
                }   
                else 
                {
                    projectCodeError.textContent = "";
                    const modal = new bootstrap.Modal(document.getElementById("saveModal"));
                    modal.show();
                }
            } 
            catch (err) 
            {
                console.error(err);
            }
        });
        // 🔹 Save only button
            
        const btnSaveOnly = document.getElementById("btnSaveOnly");
        btnSaveOnly?.addEventListener("click", function () {
            redirectInput.value = "false";
            form.submit();
        });

        // 🔹 Save & Add employee button
        const btnSaveAndAdd = document.getElementById("btnSaveAndAdd");
        btnSaveAndAdd?.addEventListener("click", function () {
            redirectInput.value = "true";
            form.submit();
        });
       
        // 🔹 Date validation
        const startDateInput = document.getElementById("StartDate");
        const endDateInput = document.getElementById("EndDate");
        const errorSpan = document.getElementById("dateError");

        function validateDates() {
            if (!startDateInput?.value || !endDateInput?.value) { errorSpan.textContent = ""; return; }
            const startDate = new Date(startDateInput.value);
            const endDate = new Date(endDateInput.value);
            if (endDate < startDate) {
                errorSpan.textContent = "End Date cannot be before Start Date.";
                endDateInput.value = "";
            } else {
                errorSpan.textContent = "";
            }
        });

       function validateField(field) {
           const errorSpan = field.closest(".single-input-box").querySelector(".field-validation");
           let fieldName = "";

           if (field.tagName.toLowerCase() === "input" || field.tagName.toLowerCase() === "textarea") {
               // use placeholder text for inputs & textareas
               fieldName = field.placeholder || "This field";
           } else if (field.tagName.toLowerCase() === "select") {
               const selectedOption = field.options[field.selectedIndex];
               fieldName = selectedOption.text === "-- Select Company Name --" || selectedOption.value === ""
                           ? "This field"
                           : selectedOption.text;
           }

           if (!field.value || field.value.trim() === "") {
               field.classList.add("is-invalid");
               if (errorSpan) errorSpan.textContent = fieldName + " is required";
               return false;
           } else {
               field.classList.remove("is-invalid");
               if (errorSpan) errorSpan.textContent = "";
               return true;
           }
       }

    });
</script>


<!-- CSS for invalid fields -->
<style>
    .is-invalid {
        border: 1px solid red;
        background-color: #fff5f5;
    }

    .field-validation {
        font-size: 0.9rem;
        color: red;
    }
</style>


@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 🔹 Save confirmation popup handling
            const btnSave = document.getElementById("btnSave");
            const form = document.getElementById("projectMasterForm");
            const btnSaveOnly = document.getElementById("btnSaveOnly");
            const btnSaveAndAdd = document.getElementById("btnSaveAndAdd");
            const redirectInput = document.getElementById("RedirectToEmployee");


            // Open popup when clicking Save
            btnSave?.addEventListener("click", function (e) {
                e.preventDefault();
                const modal = new bootstrap.Modal(document.getElementById("saveModal"));
                modal.show();
            });

            // Save only
            btnSaveOnly?.addEventListener("click", function () {
                redirectInput.value = "false";
                form.submit();
            });

            // Save and redirect to ProjectEmployee
            btnSaveAndAdd?.addEventListener("click", function () {
                redirectInput.value = "true";
                form.submit();
            });

            // 🔹 Date validation
            const startDateInput = document.getElementById("StartDate");
            const endDateInput = document.getElementById("EndDate");
            const errorSpan = document.getElementById("dateError");

            function validateDates() {
                if (!startDateInput?.value || !endDateInput?.value) { errorSpan.textContent = ""; return; }
                const startDate = new Date(startDateInput.value);
                const endDate = new Date(endDateInput.value);
                if (endDate < startDate) {
                    errorSpan.textContent = "End Date cannot be before Start Date.";
                    endDateInput.value = "";
                } else {
                    errorSpan.textContent = "";
                }
            }

            startDateInput?.addEventListener("change", function () {
                endDateInput.min = startDateInput.value;
                validateDates();
            });
            endDateInput?.addEventListener("change", validateDates);
        });
    </script>

}
}
    
