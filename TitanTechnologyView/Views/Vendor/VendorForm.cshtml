@model TitanTechnologyView.Models.VendorDto

@{
    ViewData["Title"] = Model.VendorId == 0  ? "Add Vendor" : "Edit Vendor";
    var apiOrigin = (string)(ViewBag.ApiOrigin ?? "");
}

<div class="hero-area-form style-one d-flex align-items-center">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcumb-content">
                    @* <h4>Vendors</h4> *@
                    <ul>
                        <li><a asp-action="Index" asp-controller="Home">Home</a></li>
                        <li>></li>
                        <li>Vendors</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="contact-area style-three inner">
    <div class="container">
        <div class="row add-white-bg align-items-center">
            <div class="col-lg-12 col-md-12">
                <div class="single-contact-box">
                    <div class="contact-contetn">
                        <h4>Vendor</h4>
                    </div>
                    <form asp-controller="Vendor" asp-action="SaveVendor" method="post" enctype="multipart/form-data" id="companyForm">
                        <input type="hidden" asp-for="VendorId" />
                        <input type="hidden" asp-for="ExistingGstnUpload" />
                        <input type="hidden" asp-for="ExistingPanUpload" />
                        <input type="hidden" asp-for="ExistingCancelledCheque" />
                        <input type="hidden" asp-for="ExistingAgreement1" />
                        <input type="hidden" asp-for="ExistingAgreement2" />
                        <input type="hidden" asp-for="ExistingAgreement3" />
                        <input type="hidden" asp-for="ExistingAgreement4" />

                        <div class="row">
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <select asp-for="CompanyCode" class="form-select" required>
                                        <option value=""> Company Name </option>
                                        @foreach (var company in (List<TitanTechnologyView.Models.CompanyMaster>)ViewBag.Companies)
                                        {
                                            <option value="@company.CompanyCode"
                                                    selected="@(Model.CompanyCode == company.CompanyCode ? "selected" : null)">
                                                @* @company.CompanyName (@company.CompanyCode) *@
                                                @company.CompanyName 
                                            </option>
                                        }
                                    </select>
                                    <span asp-validation-for="CompanyCode" class="text-danger field-validation"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="VendorName" type="text" placeholder="Vendor Name" required />
                                    <span asp-validation-for="VendorName" class="text-danger field-validation"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="Address" type="text" placeholder="Address" required />
                                    <span asp-validation-for="Address" class="text-danger field-validation"></span>
                                </div>
                            </div>
                            
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="Gstn" type="text" placeholder="GST Number" required />
                                    <span asp-validation-for="Gstn" class="text-danger field-validation"></span>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="PanNumber" type="text" placeholder="PAN Number" required />
                                    <span asp-validation-for="PanNumber" class="text-danger field-validation"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="ContactPersonName" type="text" placeholder="Contact Person Name" required />
                                    <span asp-validation-for="ContactPersonName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="ContactPersonNumber" type="text" placeholder="Contact Person Number" required />
                                    <span asp-validation-for="ContactPersonNumber" class="text-danger field-validation"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="PaymentTerms" type="text" placeholder="Payment Terms" required />
                                    <span asp-validation-for="PaymentTerms" class="text-danger field-validation"></span>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="AccountHolderName" type="text" placeholder="Account Holder Name" required />
                                    <span asp-validation-for="AccountHolderName" class="text-danger field-validation"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="AccountNumber1" type="text" placeholder="Account Number 1" required />
                                    <span asp-validation-for="AccountNumber1" class="text-danger field-validation"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="IfscCode" type="text" placeholder="IFSC Code" required />
                                    <span asp-validation-for="IfscCode" class="text-danger field-validation"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="BankAccountName" type="text" placeholder="Bank Acoount Name" required />
                                    <span asp-validation-for="BankAccountName" class="text-danger field-validation"></span>
                                </div>
                            </div>

                            <hr class="my-1" />

                            <div class="col-lg-2"><p class="text-end">Gst Number</p></div>
                            <div class="col-lg-4">

                                @if (!string.IsNullOrWhiteSpace(Model.ExistingGstnUpload))
                                {
                                    <div><a href="@($"{apiOrigin}{Model.ExistingGstnUpload}")" target="_blank">View existing file</a></div>
                                }
                                <input asp-for="GstnUpload" type="file" />
                            </div>

                            <div class="col-lg-2"><p class="text-end">PAN Card</p></div>
                            <div class="col-lg-4">

                                @if (!string.IsNullOrWhiteSpace(Model.ExistingPanUpload))
                                {
                                    <div><a href="@($"{apiOrigin}{Model.ExistingPanUpload}")" target="_blank">View existing file</a></div>
                                }
                                <input asp-for="PanUpload" type="file" />
                            </div>

                            <div class="col-lg-2"><p class="text-end">Cancelled Check</p></div>
                            <div class="col-lg-4">

                                @if (!string.IsNullOrWhiteSpace(Model.ExistingCancelledCheque))
                                {
                                    <div><a href="@($"{apiOrigin}{Model.ExistingCancelledCheque}")" target="_blank">View existing file</a></div>
                                }
                                <input asp-for="CancelledCheque" type="file" />
                            </div>

                            <div class="col-lg-2"><p class="text-end">Agreement File 1</p></div>
                            <div class="col-lg-4">

                                @if (!string.IsNullOrWhiteSpace(Model.ExistingAgreement1))
                                {
                                    <div><a href="@($"{apiOrigin}{Model.ExistingAgreement1}")" target="_blank">View existing file</a></div>
                                }
                                <input asp-for="Agreement1" type="file" />
                            </div>

                            <div class="col-lg-2"><p class="text-end">Agreement File 2</p></div>
                            <div class="col-lg-4">

                                @if (!string.IsNullOrWhiteSpace(Model.ExistingAgreement2))
                                {
                                    <div><a href="@($"{apiOrigin}{Model.ExistingAgreement2}")" target="_blank">View existing file</a></div>
                                }
                                <input asp-for="Agreement2" type="file" />
                            </div>

                            <div class="col-lg-2"><p class="text-end">Agreement File 3</p></div>
                            <div class="col-lg-4">

                                @if (!string.IsNullOrWhiteSpace(Model.ExistingAgreement3))
                                {
                                    <div><a href="@($"{apiOrigin}{Model.ExistingAgreement3}")" target="_blank">View existing file</a></div>
                                }
                                <input asp-for="Agreement3" type="file" />
                            </div>
                        
                            <div class="col-lg-2"><p class="text-end">Agreement File 4</p></div>
                            <div class="col-lg-4">

                                @if (!string.IsNullOrWhiteSpace(Model.ExistingAgreement4))
                                {
                                    <div><a href="@($"{apiOrigin}{Model.ExistingAgreement4}")" target="_blank">View existing file</a></div>
                                }
                                <input asp-for="Agreement4" type="file" />
                            </div>

                            <div class="d-flex gap-3 mt-4">
                                <button type="submit" class="btn btn-primary px-4">              
                                    Save
                                    @* @(Model.VendorId == 0 ? "Add Vendor" : "Update Vendor") *@ 
                                </button>
                                <a asp-action="Index" class="btn btn-outline-secondary px-4">Back</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>



<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("companyForm");
        const requiredFields = form.querySelectorAll("input[required], select[required]");

        // Validate on blur (inputs) and change (selects)
        requiredFields.forEach(field => {
            field.addEventListener("blur", () => validateField(field));
            field.addEventListener("change", () => validateField(field));
        });

        // Validate all on submit
        form.addEventListener("submit", function (e) {
            let valid = true;
            requiredFields.forEach(field => {
                if (!validateField(field)) valid = false;
            });

            if (!valid) {
                e.preventDefault();
                alert("Please fill all required fields correctly.");
            }
        });

        function validateField(field) {
            const errorSpan = field.parentElement.querySelector(".field-validation");
            let fieldName = "";

            // Determine the field name for the error message
            if (field.tagName.toLowerCase() === "input") {
                fieldName = field.placeholder || "This field";
            } else if (field.tagName.toLowerCase() === "select") {
                const selectedOption = field.options[field.selectedIndex];
                fieldName = selectedOption.text === "-- Select Company Name --" || selectedOption.value === ""
                            ? "This field"
                            : selectedOption.text;
            }

            // Check if value is empty
            if (!field.value || field.value.trim() === "") {
                field.classList.add("is-invalid");
                if (errorSpan) errorSpan.textContent = fieldName + " is required";
                return false;
            } else {
                field.classList.remove("is-invalid");
                if (errorSpan) errorSpan.textContent = "";
                return true;
            }
        }
    });
</script>


<!-- CSS for invalid fields -->
<style>
    .is-invalid {
        border: 1px solid red;
        background-color: #fff5f5;
    }

    .field-validation {
        font-size: 0.9rem;
        color: red;
    }
</style>