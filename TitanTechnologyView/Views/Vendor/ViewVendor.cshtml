@using TitanTechnologyView.Extensions
@model TitanTechnologyView.Models.VendorDto
@{
    ViewBag.Title = "Vendors";
}

<div class="hero-area-form style-one d-flex align-items-center">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcumb-content">
                    <h4>Vendors</h4>
                    <ul>
                        <li><a asp-action="Index" asp-controller="Home">Vendor</a></li>
                        <li>></li>
                        <li>View Vendors</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="container mt-5">
    <div class="card shadow-lg border-0 rounded-3">
        <div class="card-header bg-primary py-3 d-flex justify-content-between align-items-center">
            <h3 class="mb-0 fw-bold text-white d-flex align-items-center">
                <i class="bi bi-person-badge-fill me-2 fs-4 text-white"></i>
                Vendor Details
            </h3>
            <a asp-action="Index" class="btn btn-outline-light btn-sm fw-bold">
                <i class="bi bi-arrow-left me-1"></i> Back to List
            </a>
        </div>


        <div class="card-body p-4">
            <div class="row">
                <!-- Left Column: General Information -->
                <div class="col-md-6 border-end pe-4">
                    <h4 class="text-primary fw-bold border-bottom pb-2 mb-4">
                        <i class="bi bi-info-circle me-2"></i> General Information
                    </h4>

                    <div class="row mb-3">
                        <div class="col-md-4 text-muted fw-semibold">Company Code</div>
                        <div class="col-md-8">@Model.CompanyCode</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 text-muted fw-semibold">Vendor Name</div>
                        <div class="col-md-8">@Model.VendorName</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 text-muted fw-semibold">Address</div>
                        <div class="col-md-8">@Model.Address</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 text-muted fw-semibold">GSTN</div>
                        <div class="col-md-8">@Model.Gstn</div>
                    </div>  
                    
                    <div class="row mb-3">
                        <div class="col-md-4 text-muted fw-semibold">PAN Number</div>
                        <div class="col-md-8">@Model.PanNumber</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 text-muted fw-semibold">Contact Person Name</div>
                        <div class="col-md-8">@Model.ContactPersonName</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 text-muted fw-semibold">Contact Person Number</div>
                        <div class="col-md-8">@Model.ContactPersonNumber</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 text-muted fw-semibold">Payment Terms</div>
                        <div class="col-md-8">@Model.PaymentTerms</div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 text-muted fw-semibold">Account Holder Name</div>
                        <div class="col-md-8">@Model.AccountHolderName</div>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-4 text-muted fw-semibold">Account Number1</div>
                        <div class="col-md-8">@Model.AccountNumber1</div>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-4 text-muted fw-semibold">IFSC Code</div>
                        <div class="col-md-8">@Model.IfscCode</div>
                    </div>
                    
                    <div class="row mb-3">
                        <div class="col-md-4 text-muted fw-semibold">Bank Account Name</div>
                        <div class="col-md-8">@Model.BankAccountName</div>
                    </div>                
                </div>

                <!-- Right Column: Bank & PAN -->
                <div class="col-md-6 ps-4">
                    <h4 class="text-primary fw-bold border-bottom pb-2 mb-4">
                        <i class="bi bi-file-earmark-arrow-down me-2"></i> Uploaded Files
                    </h4>

                    <div class="row mb-3">
                        <div class="col-md-4 text-muted fw-semibold">Agreement1</div>
                        <div class="col-md-8">
                            @if (!string.IsNullOrEmpty(Model.Agreement1))
                            {
                                <a href="@Url.Content(Model.Agreement1)"
                                   class="text-decoration-none text-success fw-semibold"
                                   target="_blank">
                                    @FileHelpers.GetCleanFileName(Model.Agreement1)
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">Not Uploaded</span>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 text-muted fw-semibold">Agreement2</div>
                        <div class="col-md-8">
                            @if (!string.IsNullOrEmpty(Model.Agreement2))
                            {
                                <a href="@Url.Content(Model.Agreement2)"
                                   class="text-decoration-none text-success fw-semibold"
                                   target="_blank">
                                    @FileHelpers.GetCleanFileName(Model.Agreement2)
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">Not Uploaded</span>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 text-muted fw-semibold">Agreement3</div>
                        <div class="col-md-8">
                            @if (!string.IsNullOrEmpty(Model.Agreement3))
                            {
                                <a href="@Url.Content(Model.Agreement3)"
                                   class="text-decoration-none text-success fw-semibold"
                                   target="_blank">
                                    @FileHelpers.GetCleanFileName(Model.Agreement3)
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">Not Uploaded</span>
                            }
                        </div>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-4 text-muted fw-semibold">Agreement4 </div>
                        <div class="col-md-8">
                            @if (!string.IsNullOrEmpty(Model.Agreement4))
                            {
                                <a href="@Url.Content(Model.Agreement4)"
                                   class="text-decoration-none text-success fw-semibold"
                                   target="_blank">
                                    @FileHelpers.GetCleanFileName(Model.Agreement4)
                                </a>
                            }
                            else
                            {
                                <span class="text-muted">Not Uploaded</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
