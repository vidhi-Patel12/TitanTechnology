@model TitanTechnologyView.Models.CompanyMaster

@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.CompanyCode) ? "Create Company" : "Edit Company";
    var apiOrigin = (string)(ViewBag.ApiOrigin ?? "");
}

<div class="hero-area-form style-one d-flex align-items-center">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcumb-content">
                    <h4>Companys</h4>
                    <ul>
                        <li><a asp-action="Index" asp-controller="Home">Home</a></li>
                        <li>></li>
                        <li>Companys</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="contact-area style-three inner">
    <div class="container">
        <div class="row add-white-bg align-items-center">
            <div class="col-lg-12 col-md-12">
                <div class="single-contact-box">
                    <div class="contact-contetn">
                        <h4>Company</h4>
                    </div>
                    <form asp-controller="Company" asp-action="AddCompany" method="post" enctype="multipart/form-data">
                        <div class="row">
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    @if (string.IsNullOrEmpty(Model.CompanyCode))
                                    {
                                        <input asp-for="CompanyCode" placeholder="CompanyCode" />
                                    }
                                    else
                                    {
                                        <input type="text" value="@Model.CompanyCode" placeholder="CompanyCode" readonly />
                                        <input type="hidden" asp-for="CompanyCode" />
                                    }
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="CompanyName" type="text" placeholder="Company Name" required />
                                    <span asp-validation-for="CompanyName" class="text-danger"></span>

                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="CompanyAddress" type="text" placeholder="Company Address" required />
                                    <span asp-validation-for="CompanyAddress" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="Gstn" type="text" placeholder="GSTN" required />
                                    <span asp-validation-for="Gstn" class="text-danger"></span>
                                </div>
                            </div>
                           
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="PanNumber" type="text" placeholder="PAN Number" required />
                                    <span asp-validation-for="PanNumber" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="ContactPersonName" type="text" placeholder="Contact Person Name" required />
                                    <span asp-validation-for="ContactPersonName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="ContactPersonNumber" type="text" placeholder="Contact Person Number" required />
                                    <span asp-validation-for="ContactPersonNumber" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="PaymentTerms" type="text" placeholder="Payment Terms" required />
                                    <span asp-validation-for="PaymentTerms" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="BankName" type="text" placeholder="BankName" required />
                                    <span asp-validation-for="BankName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="AccountName" type="text" placeholder="Account Name" required />
                                    <span asp-validation-for="AccountName" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="BankAccountNumber" type="text" placeholder="Bank Account Number" required />
                                    <span asp-validation-for="BankAccountNumber" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="IfscCode" type="text" placeholder="IFSC Code" required />
                                    <span asp-validation-for="IfscCode" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="Micr" type="text" placeholder="Micr" required />
                                    <span asp-validation-for="Micr" class="text-danger"></span>
                                </div>
                            </div>                            

                            <div class="d-flex gap-3 mt-4">
                                <button type="submit" class="btn btn-primary px-4">              
                                    Save
                                </button>
                                <a asp-action="Index" class="btn btn-outline-secondary px-4">Back</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

