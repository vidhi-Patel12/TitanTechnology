@model IEnumerable<TitanTechnologyView.Models.EmployeeFormDto>
@{
    ViewBag.Title = "Employees";
}

<div class="hero-area-form style-one d-flex align-items-center">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcumb-content">
                    @* <h4>Employees</h4> *@
                    <ul>
                        <li><a asp-action="Index" asp-controller="Home">Home</a></li>
                        <li>></li>
                        <li>Employees</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Employees</h2>
        <a asp-action="AddEmployee" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> Add Employee
        </a>
    </div>

    <div class="table-responsive mb-5">
        <table id="employeesTable" class="table table-striped table-hover align-middle" style="width:100%">
            <thead class="table-dark">
                <tr>
                    <th>Name</th>
                    <th>Employee Type</th>
                    <th>Company Code</th>
                    <th>Vendor</th>
                    <th>Skill Set</th>
                    <th>Experience</th>
                    <th>Contact Number</th>
                    <th>Employee Type</th>
                    <th>Company Code</th>
                    <th>Vendor</th>
                    <th>Name</th>
                    <th>Alt Name</th>
                    <th>Age</th>
                    <th>Skill Set</th>
                    <th>Experience</th>
                    <th>Timing Availability</th>
                    <th>Contact Number1</th>
                    <th>Contact Number2</th>
                    <th>Remarks</th>
                    <th>ReferredBy</th>
                    <th>CreatedBy</th>
                    <th>Pan Number</th>
                    <th>Account Number1</th>
                    <th>IfscCode1</th>
                    <th>Account Name1</th>
                    <th>Pan Number2</th>
                    <th>Account Number2</th>
                    <th>IfscCode2</th>
                    <th>Account Name2</th>
                    <th class="text-center">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@item.EmployeeType</td>
                        <td>@item.CompanyCode</td>
                        <td>@item.VendorName</td>
                        <td>@item.SkillSet</td>
                        <td>@item.Experience</td>
                        <td>@item.ContactNumber1</td>
                        
                        <td class="text-center">
                            <div class="d-flex justify-content-center gap-2">
                                <a asp-action="Details" asp-route-id="@item.EmployeeId"
                                   class="btn btn-sm btn-outline-info" title="View">
                                    <i class="bi bi-eye"></i>
                                </a>

                                <a asp-action="AddEmployee" asp-route-id="@item.EmployeeId"
                                   class="btn btn-sm btn-outline-primary" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>

                                <a href="javascript:void(0);" class="btn btn-sm btn-outline-danger"
                                   data-bs-toggle="modal" data-bs-target="#deleteModal"
                                   data-id="@item.EmployeeId" title="Delete">
                                    <i class="bi bi-trash"></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                Are you sure you want to delete this employee? This action cannot be undone.
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <a id="confirmDeleteBtn" class="btn btn-danger">Delete</a>
            </div>
        </div>
    </div>
</div>

