@using TitanTechnologyView.Models
@model TitanTechnologyView.Models.EmployeeFormDto
@{
    ViewData["Title"] = Model.EmployeeId == 0 ? "Add Employee" : "Edit Employee";
    var apiOrigin = (string)(ViewBag.ApiOrigin ?? "");
}

<div class="hero-area-form style-one d-flex align-items-center">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcumb-content">
                    @* <h4>Employees</h4> *@
                    <ul>
                        <li><a asp-action="Index" asp-controller="Home">Home</a></li>
                        <li>></li>
                        <li>Employees</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="contact-area style-three inner">
    <div class="container">
        <div class="row add-white-bg align-items-center">
            <div class="col-lg-12 col-md-12">
                <div class="single-contact-box">
                    <div class="contact-contetn">
                        <h4>Employee</h4>
                    </div>
                    <form asp-controller="Employee" asp-action="SaveEmployee" method="post" enctype="multipart/form-data" id="companyForm">
                        <input type="hidden" asp-for="EmployeeId" />
                        <input type="hidden" asp-for="NdaUpload" />
                        <input type="hidden" asp-for="AadharUpload" />
                        <input type="hidden" asp-for="PanUpload" />
                        <input type="hidden" asp-for="Cheque1Upload" />
                        <input type="hidden" asp-for="Aadhar2Upload" />
                        <input type="hidden" asp-for="PanUpload2" />
                        <input type="hidden" asp-for="Cheque2Upload" />

                        <div class="row">
                            <div class="col-lg-6 mb-4">
                                <div class="single-input-box">
                                    <select asp-for="EmployeeType" class="form-select" required>
                                        <option value="">Select Employee Type</option>
                                        @foreach (var type in (List<DropdownMaster>)ViewBag.EmployeeTypes)
                                        {
                                            <option value="@type.Value">@type.Value</option>
                                        }
                                    </select>
                                    <span asp-validation-for="EmployeeType" class="text-danger field-validation"></span>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <select asp-for="CompanyCode" class="form-select" required
                                            asp-items="@(ViewBag.Companys != null
                                                                                                                                                                                                                            ? new SelectList(ViewBag.Companys, "CompanyCode", "CompanyName", Model?.CompanyCode)
                                                                                                                                                                                                                            : new List<SelectListItem>())">
                                        <option value="">Select Company Name</option>
                                    </select>
                                    <span asp-validation-for="CompanyCode" class="text-danger field-validation"></span>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <select asp-for="VendorId" class="form-select" required
                                            asp-items="@(ViewBag.Vendors != null
                                                                                                                                                                                                                        ? new SelectList(ViewBag.Vendors, "VendorId", "VendorName", Model?.VendorId)
                                                                                                                                                                                                                        : new List<SelectListItem>())">
                                        <option value=""> Select Vendor </option>
                                    </select>
                                    <span asp-validation-for="VendorId" class="text-danger field-validation"></span>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="Name" type="text" placeholder="Name" required />
                                    <span asp-validation-for="Name" class="text-danger field-validation"></span>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="AltName" type="text" placeholder="Alt Name" />
                                    <span asp-validation-for="AltName" class="text-danger field-validation"></span>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="Age" type="text" placeholder="Age" required />
                                    <span asp-validation-for="Age" class="text-danger field-validation"></span>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="SkillSet" type="text" placeholder="Skill Set" required />
                                    <span asp-validation-for="SkillSet" class="text-danger field-validation"></span>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="Experience" type="text" placeholder="Experience" required />
                                    <span asp-validation-for="Experience" class="text-danger field-validation"></span>
                                </div>
                            </div>

                            <div class="col-lg-6 mb-4">
                                <div class="single-input-box">
                                    <select asp-for="TimingAvailability" class="form-select" required>
                                        <option value="">Select Timing Availability</option>
                                        @foreach (var type in (List<DropdownMaster>)ViewBag.TimingAvailabilitys)
                                        {
                                            <option value="@type.Value">@type.Value</option>
                                        }
                                    </select>
                                    <span asp-validation-for="TimingAvailability" class="text-danger field-validation"></span>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="ContactNumber1" type="text" placeholder="Contact Number 1" required />
                                    <span asp-validation-for="ContactNumber1" class="text-danger field-validation"></span>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="ContactNumber2" type="text" placeholder="Contact Number 2" />
                                    <span asp-validation-for="ContactNumber2" class="text-danger field-validation"></span>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="Remarks" type="text" placeholder="Remarks" required />
                                    <span asp-validation-for="Remarks" class="text-danger field-validation"></span>
                                </div>
                            </div>

                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="ReferredBy" type="text" placeholder="Referred By" required />
                                    <span asp-validation-for="ReferredBy" class="text-danger field-validation"></span>
                                </div>
                            </div>

                            @* <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="CreatedBy" type="text" placeholder="Created By" required />
                                    <span asp-validation-for="CreatedBy" class="text-danger"></span>
                                </div>
                            </div> *@


                            <div class="col-lg-6">
                                <div class="single-input-box">
                                    <input asp-for="PanNumber" type="text" placeholder="Pan Number" required />
                                    <span asp-validation-for="PanNumber" class="text-danger field-validation"></span>
                                </div>
                            </div>

                            <div class="row">

                                <div class="col-lg-6">
                                    <div class="single-input-box">
                                        <input asp-for="AccountNumber1" type="text" placeholder="Bank Account Number 1" required />
                                        <span asp-validation-for="AccountNumber1" class="text-danger field-validation"></span>
                                    </div>

                                    <div class="single-input-box">
                                        <input asp-for="IfscCode1" type="text" placeholder="IFSC Code 1" required />
                                        <span asp-validation-for="IfscCode1" class="text-danger field-validation"></span>
                                    </div>

                                    <div class="single-input-box">
                                        <input asp-for="AccountName1" type="text" placeholder="Account Holder Name 1" required />
                                        <span asp-validation-for="AccountName1" class="text-danger field-validation"></span>
                                    </div>

                                    <div class="single-input-box">
                                        <input asp-for="PanNumber2" type="text" placeholder="Pan Number 2" />
                                        <span asp-validation-for="PanNumber2" class="text-danger"></span>
                                    </div>

                                    <div class="single-input-box">
                                        <input asp-for="AccountNumber2" type="text" placeholder="Bank Account Number 2" />
                                        <span asp-validation-for="AccountNumber2" class="text-danger"></span>
                                    </div>

                                    <div class="single-input-box">
                                        <input asp-for="IfscCode2" type="text" placeholder="IFSC Code 2" />
                                        <span asp-validation-for="IfscCode2" class="text-danger"></span>
                                    </div>
                                    <div class="single-input-box">
                                        <input asp-for="AccountName2" type="text" placeholder="Account Holder Name 2" />
                                        <span asp-validation-for="AccountName2" class="text-danger"></span>
                                    </div>
                                </div>
                                <div class="col-lg-6">
                                    <div class="row mt-3 mb-4">

                                        <div class="col-lg-4"><p class="text-center">NDA File</p></div>
                                        <div class="col-lg-2">
                                            @if (!string.IsNullOrWhiteSpace(Model.NdaUpload))
                                            {
                                                <div><a href="@($"{apiOrigin}{Model.NdaUpload}")" target="_blank">View existing file</a></div>
                                            }
                                            <input asp-for="NdaFile" type="file" />
                                        </div>
                                    </div>

                                    <div class="row  mb-4">
                                        <div class="col-lg-4"><p class="text-center">Adhar Card</p></div>
                                        <div class="col-lg-2">
                                            @if (!string.IsNullOrWhiteSpace(Model.AadharUpload))
                                            {
                                                <div><a href="@($"{apiOrigin}{Model.AadharUpload}")" target="_blank">View existing file</a></div>
                                            }
                                            <input asp-for="AadharFile1" type="file" />
                                        </div>
                                    </div>

                                    <div class="row mb-4">

                                        <div class="col-lg-4 mt-2"><p class="text-center">PAN Card </p></div>
                                        <div class="col-lg-2">
                                            @if (!string.IsNullOrWhiteSpace(Model.PanUpload))
                                            {
                                                <div><a href="@($"{apiOrigin}{Model.PanUpload}")" target="_blank">View existing file</a></div>
                                            }
                                            <input asp-for="PanFile1" type="file" />
                                        </div>

                                    </div>

                                    <div class="row mb-4">

                                        <div class="col-lg-4 mt-1"><p class="text-center">Cheque</p></div>
                                        <div class="col-lg-2">

                                            @if (!string.IsNullOrWhiteSpace(Model.Cheque1Upload))
                                            {
                                                <div><a href="@($"{apiOrigin}{Model.Cheque1Upload}")" target="_blank">View existing file</a></div>
                                            }
                                            <input asp-for="ChequeFile1" type="file" />
                                        </div>

                                    </div>

                                    <div class="row mb-4 ">

                                        <div class="col-lg-4"><p class="text-center">Adhar Card 2</p></div>
                                        <div class="col-lg-2">

                                            @if (!string.IsNullOrWhiteSpace(Model.Aadhar2Upload))
                                            {
                                                <div><a href="@($"{apiOrigin}{Model.Aadhar2Upload}")" target="_blank">View existing file</a></div>
                                            }
                                            <input asp-for="AadharFile2" type="file" />
                                        </div>

                                    </div>

                                    <div class="row  mb-4">
                                        <div class="col-lg-4">
                                            <p class="text-center" style="margin-top: 10px;">PAN Card 2 </p>
                                        </div>
                                        <div class="col-lg-2">
                                            @if (!string.IsNullOrWhiteSpace(Model.PanUpload2))
                                            {
                                                <div><a href="@($"{apiOrigin}{Model.PanUpload2}")" target="_blank">View existing file</a></div>
                                            }
                                            <input asp-for="PanFile2" type="file" />
                                        </div>

                                    </div>

                                    <div class="row mb-4">

                                        <div class="col-lg-4"><p class="text-center">Cheque 2</p></div>
                                        <div class="col-lg-2">

                                            @if (!string.IsNullOrWhiteSpace(Model.Cheque2Upload))
                                            {
                                                <div><a href="@($"{apiOrigin}{Model.Cheque2Upload}")" target="_blank">View existing file</a></div>
                                            }
                                            <input asp-for="ChequeFile2" type="file" />
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-3 mt-4">
                                <button type="submit" class="btn btn-primary px-4">
                                    @(Model.EmployeeId == 0 ? "Save" : "Save")
                                </button>
                                <a asp-action="Index" class="btn btn-outline-secondary px-4">Back</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>



<script>
    document.addEventListener("DOMContentLoaded", function () {
        const form = document.getElementById("companyForm");
        const requiredFields = form.querySelectorAll("input[required], select[required]");

        // Validate on blur (inputs) and change (selects)
        requiredFields.forEach(field => {
            field.addEventListener("blur", () => validateField(field));
            field.addEventListener("change", () => validateField(field));
        });

        // Validate all on submit
        form.addEventListener("submit", function (e) {
            let valid = true;
            requiredFields.forEach(field => {
                if (!validateField(field)) valid = false;
            });

            if (!valid) {
                e.preventDefault();
                alert("Please fill all required fields correctly.");
            }
        });

        function validateField(field) {
            const errorSpan = field.parentElement.querySelector(".field-validation");
            let fieldName = "";

            // Determine the field name for the error message
            if (field.tagName.toLowerCase() === "input") {
                fieldName = field.placeholder || "This field";
            } else if (field.tagName.toLowerCase() === "select") {
                const selectedOption = field.options[field.selectedIndex];
                fieldName = selectedOption.text === "-- Select Company Name --" || selectedOption.value === ""
                            ? "This field"
                            : selectedOption.text;
            }

            // Check if value is empty
            if (!field.value || field.value.trim() === "") {
                field.classList.add("is-invalid");
                if (errorSpan) errorSpan.textContent = fieldName + " is required";
                return false;
            } else {
                field.classList.remove("is-invalid");
                if (errorSpan) errorSpan.textContent = "";
                return true;
            }
        }
    });
</script>


<!-- CSS for invalid fields -->
<style>
    .is-invalid {
        border: 1px solid red;
        background-color: #fff5f5;
    }

    .field-validation {
        font-size: 0.9rem;
        color: red;
    }
</style>