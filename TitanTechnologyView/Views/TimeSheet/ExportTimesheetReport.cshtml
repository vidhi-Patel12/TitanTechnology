@{
    ViewData["Title"] = "Export Timesheet Report";
}

<div class="hero-area-form style-one d-flex align-items-center">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcumb-content">
                    @* <h4>Companys</h4> *@
                    <ul>
                        <li><a asp-action="Index" asp-controller="Home">Home</a></li>
                        <li>></li>
                        <li>Export Timesheet Report</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>


<form  class="mt-5 mb-5" method="get" asp-action="ExportTimesheetReport" asp-controller="Timesheet">
    <div class="form-group">
        <label class="text-black" for="workMonth">Work Month:</label>
        <input type="month" id="workMonth" name="workMonth" class="form-control" />
    </div>

    <div class="form-group">
        <label class="text-black" for="timesheetType">Timesheet Type:</label>
        <select id="timesheetType" name="timesheetType" class="form-control">
            <option value="">-- Select Type --</option>
            <option value="Monthly">Monthly</option>
            <option value="Weekly">Weekly</option>
            <option value="Daily">Daily</option>
        </select>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Download Report</button>
</form>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mt-3">
        @TempData["ErrorMessage"]
    </div>
}
