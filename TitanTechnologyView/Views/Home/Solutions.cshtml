<style>
    .single-service-box {
        display: flex;
        flex-direction: column;
        justify-content: space-between; /* push content + button apart */
        height: 100%; /* ensures all cards stretch equally */
    }

    .service-content {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

        .service-content p {
            flex-grow: 1; /* take remaining space so button stays at bottom */
        }

        .service-content a {
            margin-top: auto; /* push button to bottom */
            align-self: center; /* keep button centered horizontally */
        }

</style>
