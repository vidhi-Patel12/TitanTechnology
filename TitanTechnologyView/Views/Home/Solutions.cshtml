<div class="process-area style-three inner">
    <div class="container">
        <div class="row add-bg">
            <div class="col-lg-4 col-md-6">
                <div class="single-process-box">
                    <div class="process-icon">
                        <img src="~/assets/images/home-3/process-1.png" alt="">
                    </div>
                    <div class="process-content">
                        @*  <h4>Register</h4> *@
                        <h4>
                            <a asp-action="Register" asp-controller="Auth">Register</a>
                        </h4>
                        <p>Create your account to explore opportunities, access exclusive features, and stay connected with us.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="single-process-box">
                    <div class="process-icon">
                        <img src="~/assets/images/home-3/process-2.png" alt="">
                    </div>
                    <div class="process-content">
                        <h4>
                            <a asp-action="About" asp-controller="Home">About Us</a>
                        </h4>
                        <p>We are committed to delivering innovative solutions that empower businesses and individuals to grow and succeed.</p>

                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="single-process-box">
                    <div class="process-icon">
                        <img src="~/assets/images/home-3/process-3.png" alt="">
                    </div>
                    <div class="process-content">
                        <h4>
                            <a asp-action="ContactUs" asp-controller="Home">Contact Us</a>
                        </h4>
                        <p>Have questions or need assistance? Get in touch with us anytime - we’re here to help you.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>



<!-- Service Details Modal -->
<div class="modal fade" id="serviceModal1" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
