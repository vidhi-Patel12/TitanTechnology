@{
    ViewData["Title"] = "Solutions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    ViewBag.Title = "Solutions";
}

<div class="hero-area-form style-one d-flex align-items-center">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcumb-content">
                    <h4>Solutions</h4>
                    <ul>
                        <li><a asp-action="Solutions" asp-controller="Home">Home</a></li>
                        <li>></li>
                        <li>Solutions</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="service-area inner-style">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="section-title center inner-style">
                    <h4>What We Provides?</h4>
                    <h1>Solutions Fully Intergated with SAP</h1>
                    <h3>Tailored Solutions. Seamless Integration.Reliable Support.</h3>
                </div>
            </div>
        </div>

        <div class="row g-4">
            <!-- g-4 adds spacing between cards -->
            <div class="col-lg-3 col-md-6 col-sm-12">
                <div class="single-service-box h-100 text-center p-4 shadow rounded">
                    <div class="service-icon mb-3">
                        <img src="~/assets/images/service-inner/service-icon-8.png" alt="">
                    </div>
                    <div class="service-content">
                        <h4>B2B E-commerce Services</h4>
                        <p>We deliver end-to-end B2B e-commerce solutions to help businesses streamline transactions, enhance customer experiences, and accelerate growth.</p>
                        <a href="#" class="btn btn-primary mt-2" data-bs-toggle="modal" data-bs-target="#serviceModal1">Learn More <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 col-sm-12">
                <div class="single-service-box h-100 text-center p-4 shadow rounded">
                    <div class="service-icon mb-3">
                        <img src="~/assets/images/service-inner/service-icon-2.png" alt="">
                    </div>
                    <div class="service-content">
                        <h4>Custom AI/ML Solutions</h4>
                        <p>Unlock the power of data with our custom AI and Machine Learning services.</p>
                        <a href="#" class="btn btn-primary mt-2" data-bs-toggle="modal" data-bs-target="#serviceModal2">Learn More <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 col-sm-12">
                <div class="single-service-box h-100 text-center p-4 shadow rounded">
                    <div class="service-icon mb-3">
                        <img src="~/assets/images/service-inner/service-icon-3.png" alt="">
                    </div>
                    <div class="service-content">
                        <h4>EXIM (Export-Import) Services</h4>
                        <p>Our EXIM services simplify the complexities of international trade.</p>
                        <a href="#" class="btn btn-primary mt-2" data-bs-toggle="modal" data-bs-target="#serviceModal3">Learn More <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>

            <div class="col-lg-3 col-md-6 col-sm-12">
                <div class="single-service-box h-100 text-center p-4 shadow rounded">
                    <div class="service-icon mb-3">
                        <img src="~/assets/images/service-inner/service-icon-4.png" alt="">
                    </div>
                    <div class="service-content">
                        <h4>E-Invoicing Solutions</h4>
                        <p>We offer robust e-invoicing solutions that streamline billing processes, ensure regulatory compliance, and improve cash flow management.</p>
                        <a href="#" class="btn btn-primary mt-2" data-bs-toggle="modal" data-bs-target="#serviceModal4">Learn More <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>






<div class="subscribe-area style-three">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="section-title left inner-style">
                    <h1>Why Choose Titan Technology for SAP?</h1>
                </div>
            </div>
            <div class="col-lg-6" style="color : white">
                <h4 style="color : white">We deliver more than support—we deliver peace of mind.</h4>
                <ul>
                    <li>• End-to-end SAP BASIS services tailored for reliability and performance</li>
                    <li>• Expert support for improved system stability and uptime</li>
                    <li>• Simplified system maintenance and proactive monitoring</li>
                    <li>• Enhanced operational efficiency through optimized SAP environments</li>
                    <li>• Strategic guidance for digital growth and innovation</li>
                    <li>• Certified consultants committed to your success</li>
                </ul>
            </div>
        </div>
    </div>
</div>
