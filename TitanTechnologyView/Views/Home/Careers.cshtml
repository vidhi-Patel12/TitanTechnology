<style>
    body {
        font-family: Arial, sans-serif;
        background-color: #f7faff;
        margin: 0;
        /* padding: 20px; */
    }

    #career-list {
        margin-top: 90px;
    }

    .career-item {
        padding: 40px 0;
        border-top: 3px solid #e5eaf1;
        margin: 0 40px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 40px;
    }

    .career-left {
        flex: 1;
        width: 40%;
        margin-left: 70px;
    }

    .career-right {
        flex: 1;
        /* text-align: right; */
        /* margin-right: 450px; */
    }

    .badge {
        display: inline-block;
        background: #1d73e8;
        color: #fff;        
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 16px;
        /* font-weight: bold; */
        margin-right: 0px;
        font-family: "Nunito", sans-serif;
    }

    .location {
        font-size: 14px;
        color: #555;
    }

    .job-title {
        font-size: 22px;
        font-weight: bold;
        margin: 15px 0;
        color: #0d2235;
    }

    .job-desc {
        font-size: 15px;
        color: #666;
        line-height: 1.6;
        margin-top: -15px;
        width: 100%;
        text-align: left;
        margin-left: -90px;
    }

    .apply-btn {
        border: 1px solid #cfd3da;
        background: transparent;
        padding: 12px 28px;
        border-radius: 30px;
        font-size: 15px;
        /* font-weight: bold; */
        cursor: pointer;
        transition: all 0.3s ease;
        margin-left: 0%;
        width: 185px;
        margin-top: 10px;
        margin-right: 60px;
    }

        .apply-btn:hover {
            background: #1d73e8;
            color: #fff;
        }

    /* remove border for first item */
    .career-item:first-child {
        border-top: none;
    }
</style>

