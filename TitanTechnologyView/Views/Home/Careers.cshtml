<div class="choose-us-area inner-style mt-0">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="section-title left style-two">
                    <h1>Why Work With Us?</h1>
                </div>
                <div class="single-choose-us-item">
                    <ul>
                        <li>Collaborative and inclusive work culture.</li>
                        <li>Continuous learning and professional development.</li>
                        <li>Exciting projects with global clients.</li>
                        <li>Competitive compensation and benefits.</li>
                    </ul>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="choose-us-thumb">
                    <img src="~/assets/images/inner-images/choose-us-thumb.png" alt="">
                </div>
            </div>
        </div>
    </div>
    <div class="container">
        <div class="row add-marging">
            <h1 class="text-center mb-5">Who We Look For:</h1>
            <div class="col-lg-3 col-md-6">
                <div class="single-choose-us-box">
                    <div class="choose-us-icon">
                        <img src="~/assets/images/inner-images/icon_1.png" alt="" style="height: 60px;">
                    </div>
                    <div class="choose-us-content">
                        <h4>SAP Consultants </h4>
                        <p>
                            (FICO, MM, SD, ABAP, BASIS, HANA, SuccessFactors, BTP, and more)
                            We welcome SAP specialists who thrive on transforming complex systems into smart, scalable solutions.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="single-choose-us-box">
                    <div class="choose-us-icon">
                        <img src="~/assets/images/inner-images/icon_2.png" alt="" style="height: 60px;">
                    </div>
                    <div class="choose-us-content">
                        <h4>Software Developers</h4>
                        <p>
                            We seek creative coders who craft seamless digital experiences from front to back.
                            Your skills bring ideas to life and technology closer to people.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="single-choose-us-box">
                    <div class="choose-us-icon">
                        <img src="~/assets/images/inner-images/icon_3.png" alt="" style="height: 60px;">
                    </div>
                    <div class="choose-us-content">
                        <h4>Project Managers</h4>
                        <p>
                            We value leaders who balance vision with execution, keeping projects on track and teams inspired.
                            Your clarity and coordination turn challenges into achievements.
                        </p>
                    </div>
                </div>
            </div>
            <div class="col-lg-3 col-md-6">
                <div class="single-choose-us-box">
                    <div class="choose-us-icon">
                        <img src="~/assets/images/inner-images/icon_4.png" alt="" style="height: 60px;">
                    </div>
                    <div class="choose-us-content">
                        <h4>Business Analysts</h4>
                        <p>
                            We look for analytical thinkers who bridge business goals with technology solutions.
                            Your insights fuel smarter strategies and meaningful outcomes.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


