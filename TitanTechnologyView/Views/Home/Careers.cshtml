<script>
    const apiBase = "https://localhost:44368"; // change this to your API base

    async function loadCareerMaster() {
       const response = await fetch(`${apiBase}/api/Career`);
       if (!response.ok) throw new Error("HTTP " + response.status);
       return await response.json();
     }

     function renderCareers(careers) {
       const list = document.getElementById("career-list");
       list.innerHTML = "";

       careers.forEach(career => {
         const item = document.createElement("div");
         item.className = "career-item";

         item.innerHTML = `
           <div class="career-left">
             <span class="badge">${career.employementtype}</span>
             <span class="location">${career.location}</span>
             <div class="job-title">${career.jobTitle}</div>
           </div>
           <div class="career-right">
             <div class="job-desc">${career.jobDescription}</div>
             
           </div>
           <button class="apply-btn">Apply Now</button>
         `;

         list.appendChild(item);
       });
     }

     (async function(){
       try {
         const careers = await loadCareerMaster();
         renderCareers(careers);
       } catch (err) {
         console.error("Error loading careers:", err);
       }
     })();
</script>