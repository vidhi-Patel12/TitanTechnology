
@{
    ViewBag.Title = "Service";
}

<div class="hero-area-form style-one d-flex align-items-center">
    <div class="container">
        <div class="row">
            <div class="col-lg-12">
                <div class="breadcumb-content">
                    @* <h4>Services</h4> *@
                    <ul>
                        <li><a asp-action="Index" asp-controller="Home">Home</a></li>
                        <li>></li>
                        <li>Services</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="service-area inner-style">
    <div class="container">
        <div class="row">
            <div class="col-lg-12 text-center">
                <div class="section-title center inner-style">
                    <h4>What We Provides?</h4>
                    <h1>Provide Interective IT Solution</h1>
                    <h1>Business Services</h1>
                </div>
            </div>
        </div>

        <div class="row g-4" id="service-list">
            <!-- Services will be rendered here -->
        </div>       
    </div>
</div>

<div class="subscribe-area style-three">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div class="section-title left inner-style">
                    <h1>Why Choose Titan Technology for SAP?</h1>
                </div>
            </div>
            <div class="col-lg-6" style="color : white">
                 <h4  style="color : white">We deliver more than support—we deliver peace of mind.</h4>
                    <ul>
                        <li>• End-to-end SAP BASIS services tailored for reliability and performance</li>
                        <li>• Expert support for improved system stability and uptime</li>
                        <li>• Simplified system maintenance and proactive monitoring</li>
                        <li>• Enhanced operational efficiency through optimized SAP environments</li>  
                        <li>• Strategic guidance for digital growth and innovation</li>   
                        <li>• Certified consultants committed to your success</li>    
                    </ul>
            </div>
        </div>
    </div>
</div>

<!-- Toptech Process Area Style Three-->
<div class="process-area style-three inner">
    <div class="container">
        <div class="row add-bg">
            <div class="col-lg-4 col-md-6">
                <div class="single-process-box">
                    <div class="process-icon">
                        <img src="~/assets/images/home-3/process-1.png" alt="">
                    </div>
                    <div class="process-content">
                       @*  <h4>Register</h4> *@
                        <h4>
                            <a asp-action="Register" asp-controller="Auth">Register</a>
                        </h4>
                        <p>Create your account to explore opportunities, access exclusive features, and stay connected with us.</p>
                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="single-process-box">
                    <div class="process-icon">
                        <img src="~/assets/images/home-3/process-2.png" alt="">
                    </div>
                    <div class="process-content">
                        <h4>
                            <a asp-action="About" asp-controller="Home">About Us</a>
                        </h4>
                       <p>We are committed to delivering innovative solutions that empower businesses and individuals to grow and succeed.</p>

                    </div>
                </div>
            </div>
            <div class="col-lg-4 col-md-6">
                <div class="single-process-box">
                    <div class="process-icon">
                        <img src="~/assets/images/home-3/process-3.png" alt="">
                    </div>
                    <div class="process-content">
                         <h4>
                            <a asp-action="ContactUs" asp-controller="Home">Contact Us</a>
                        </h4>                     
                        <p>Have questions or need assistance? Get in touch with us anytime - we’re here to help you.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .single-service-box {
        display: flex;
        flex-direction: column;
        justify-content: space-between; /* push content + button apart */
        height: 100%; /* ensures all cards stretch equally */
    }

    .service-content {
        display: flex;
        flex-direction: column;
        flex-grow: 1;
    }

    .service-content p {
        flex-grow: 1; /* take remaining space so button stays at bottom */
    }

    .service-content a {
        margin-top: auto; /* push button to bottom */
        align-self: center; /* keep button centered horizontally */
    }

</style>
<script>
    const apiBase = '/Home'; // your API base

    async function loadServices() {
        const response = await fetch(`${apiBase}/GetServices`, {
                method: "GET",
                credentials: "include", //  Important: send cookies (InternalPortalAuth)
                headers: {
                    "Accept": "application/json"
                }
            });
        if (!response.ok) throw new Error("HTTP " + response.status);
        return await response.json();
    }

    function renderServices(services) {
        const list = document.getElementById("service-list");
        list.innerHTML = "";

        services.forEach((service, index) => {
            const col = document.createElement("div");
            col.className = "col-lg-4 col-md-6 col-sm-12";

            // service card
            col.innerHTML = `
                <div class="single-service-box h-100 text-center p-4 shadow rounded">
                    <div class="service-icon mb-3">
                        <img src="${apiBase}/${service.image}"
                                        alt=""
                                            class="img-fluid" style="border-radius: 43px;width: 100%;height: 100%;" />
                    </div>
                    <div class="service-content">
                        <h4>${service.serviceName}</h4>
                        <p>${service.description}</p>
                        <a href="#"
                           class="btn btn-primary mt-2"
                           data-bs-toggle="modal"
                           data-bs-target="#serviceModal${index}">
                           Learn More <i class="bi bi-arrow-right"></i>
                        </a>
                    </div>
                </div>
            `;

            list.appendChild(col);

            // create modal for each service
            const modal = document.createElement("div");
            modal.className = "modal fade";
            modal.id = `serviceModal${index}`;
            modal.tabIndex = -1;
            modal.innerHTML = `
                <div class="modal-dialog modal-xl modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title">${service.serviceName}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                        </div>
                        <div class="modal-body row">
                            <div class="col-md-6">
                                <p>${service.description}</p>
                                <ul>
                                    ${service.points ? service.points.map(p => `<li>• ${p}</li>`).join("") : ""}
                                </ul>
                            </div>
                            <div class="col-md-6 text-center">
                                <img src="${apiBase}/${service.image}" alt="" style="height: 60%;width: 90%;" class="img-fluid rounded" />
                            </div>
                        </div>
                    </div>
                </div>
            `;

            document.body.appendChild(modal);
        });
    }

    (async function(){
        try {
            const services = await loadServices();
            renderServices(services);
        } catch (err) {
            console.error("Error loading services:", err);
        }
    })();
</script>

