                //         li.innerHTML = `
                //             <a class="dropdown-item" href="/Home/ServiceDetails/${service.serviceId}" title="${service.serviceName}">
                //                 ${truncateText(service.serviceName, 20)}
                //             </a>
                //         `;
                //         dropdown.appendChild(li);
                //     });
                // }

                function renderServiceDropdown(services) {
                    const dropdowns = document.querySelectorAll("#services-list");
                    dropdowns.forEach(dropdown => {
                        dropdown.innerHTML = "";

                        if (!services || services.length === 0) {
                            dropdown.innerHTML = `<li><span class="dropdown-item text-muted">No services available</span></li>`;
                            return;
                        }

                        services.forEach(service => {
                            const li = document.createElement("li");
                            li.innerHTML = `
                                <a class="dropdown-item" href="/Home/ServiceDetails/${service.serviceId}" title="${service.serviceName}">
                                    ${truncateText(service.serviceName, 20)}
                                </a>
                            `;
                            dropdown.appendChild(li);
                        });
                    });
                }


                (async function () {
                    const services = await loadServices();
                    renderServiceDropdown(services);
                })();


                 async function loadSolutions() {
                    try {
                        const response = await fetch(`${apiUrl}/GetSolutions`, {
                        method: "GET",
                        credentials: "include", //  Important: send cookies (InternalPortalAuth)
                        headers: {
                            "Accept": "application/json"
                        }
                    });
                        if (!response.ok) throw new Error("HTTP " + response.status);
                        return await response.json();
                    } catch (err) {
                        console.error("Error fetching solutions:", err);
                        return [];
                    }
                }

