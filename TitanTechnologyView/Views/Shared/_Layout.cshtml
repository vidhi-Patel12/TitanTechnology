<style>
    div.dataTables_wrapper div.dataTables_length label, div.dataTables_wrapper div.dataTables_filter label {
        color: black;
    }

    /* Hide submenu by default */
    .mobile-menu-item-has-children > .sub-menu {
        display: none;
        list-style: none;
        padding-left: 15px;
        background: #f9f9f9;
        margin-top: 5px;
        border-left: 2px solid #ddd;
    }

    /* Show submenu when parent is open */
    .mobile-menu-item-has-children.open > .sub-menu {
        display: block;
    }

    /* Style submenu links */
    .mobile-menu-item-has-children .sub-menu li a {
        display: block;
        padding: 8px 10px;
        color: #333;
        text-decoration: none;
    }

        .mobile-menu-item-has-children .sub-menu li a:hover {
            background: #eee;
        }

    /* Toggle icon (+ / -) */
    .mobile-menu-item-has-children > a::after {
        content: " +";
        float: right;
        font-weight: bold;
        transition: all 0.3s;
    }

    .mobile-menu-item-has-children.open > a::after {
        content: " -";
    }

        div.dataTables_wrapper div.dataTables_length label, div.dataTables_wrapper div.dataTables_filter label 
        {
            color: black;
        }
</style>

