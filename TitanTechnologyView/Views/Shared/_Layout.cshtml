    @RenderSection("Scripts", required: false)

    <script>
        const apiUrl = 'https://localhost:44368'; // match your API protocol

        async function loadServices() {
            try {
                const response = await fetch(`${apiUrl}/api/Service`);
                if (!response.ok) throw new Error("HTTP " + response.status);
                return await response.json();
            } catch (err) {
                console.error("Error fetching services:", err);
                return [];
            }
        }

        function truncateText(text, maxLength = 20) {
            if (!text) return "";
            return text.length > maxLength ? text.substring(0, maxLength) + "..." : text;
        }

        function renderServiceDropdown(services) {
            const dropdown = document.getElementById("services-list");
            if (!dropdown) return;

            dropdown.innerHTML = "";

            if (!services || services.length === 0) {
                dropdown.innerHTML = `<li><span class="dropdown-item text-muted">No services available</span></li>`;
                return;
            }

            services.forEach(service => {
                const li = document.createElement("li");
                li.innerHTML = `
                    <a class="dropdown-item" href="/Home/ServiceDetails/${service.serviceId}" title="${service.serviceName}">
                        ${truncateText(service.serviceName, 20)}
                    </a>
                `;
                dropdown.appendChild(li);
            });
        }


        (async function () {
            const services = await loadServices();
            renderServiceDropdown(services);
        })();


         async function loadSolutions() {
            try {
                const response = await fetch(`${apiUrl}/api/Solution`);
                if (!response.ok) throw new Error("HTTP " + response.status);
                return await response.json();
            } catch (err) {
                console.error("Error fetching solutions:", err);
                return [];
            }
        }

                function renderSolutionDropdown(solutions) {
            const dropdown = document.getElementById("solutions-list");
            if (!dropdown) return;

            dropdown.innerHTML = "";

            if (!solutions || solutions.length === 0) {
                dropdown.innerHTML = `<li><span class="dropdown-item text-muted">No solutions available</span></li>`;
                return;
            }

            solutions.forEach(solution => {
                const li = document.createElement("li");
                li.innerHTML = `
                    <a class="dropdown-item" href="/Home/SolutionDetails/${solution.solutionId}"
                       title="${solution.solutionName}">
                        ${truncateText(solution.solutionName, 20)}
                    </a>
                `;
                dropdown.appendChild(li);
            });
        }

        (async function () {
            const solutions = await loadSolutions();
            renderSolutionDropdown(solutions);
        })();


        document.getElementById("servicesDropdown").addEventListener("click", function (e) {
            e.preventDefault(); // stop dropdown toggle
            window.location.href = "/Home/Services";
        });

        document.getElementById("solutionsDropdown").addEventListener("click", function (e) {
            e.preventDefault(); // stop dropdown toggle
            window.location.href = "/Home/Solutions";
        });


    </script>


