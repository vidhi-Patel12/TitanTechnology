                function renderSolutionDropdown(solutions) {
            const dropdowns = document.querySelectorAll("#solutions-list");

            dropdowns.forEach(dropdown => {
                dropdown.innerHTML = ""; // clear any existing items

                if (!solutions || solutions.length === 0) {
                    dropdown.innerHTML = `<li><span class="dropdown-item text-muted">No solutions available</span></li>`;
                    return;
                }

                solutions.forEach(solution => {
                    const li = document.createElement("li");
                    li.innerHTML = `
                        <a class="dropdown-item" href="/Home/SolutionDetails/${solution.solutionId}" title="${solution.solutionName}">
                             ${truncateText(solution.solutionName, 20)}
                        </a>
                    `;
                    dropdown.appendChild(li);
                });
            });
        }

                (async function () {
                    const solutions = await loadSolutions();
                    renderSolutionDropdown(solutions);
                })();


                document.getElementById("servicesDropdown").addEventListener("click", function (e) {
                    e.preventDefault(); // stop dropdown toggle
                    window.location.href = "/Home/Services";
                });

                document.getElementById("solutionsDropdown").addEventListener("click", function (e) {
                    e.preventDefault(); // stop dropdown toggle
                    window.location.href = "/Home/Solutions";
                });


                document.addEventListener("DOMContentLoaded", () => {
                    document.querySelectorAll(".mobile-menu-item-has-children > a").forEach(anchor => {
                        anchor.addEventListener("click", function (e) {
                            if (window.innerWidth <= 991) {
                                e.preventDefault();
                                this.parentElement.classList.toggle("open");
                            }
                        });
                    });

                    loadServices(); // load services dynamically if needed
                });



